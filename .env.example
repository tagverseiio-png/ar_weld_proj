# Public frontend env only. Never put AWS credentials or secrets in VITE_*.
# Copy to .env.local for local prototype work (all blank = mock mode).

# AWS HTTP API base, e.g. https://abc123.execute-api.ap-south-1.amazonaws.com
VITE_API_BASE_URL=

# Cognito public client (Hosted UI). No secrets here.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
# Defaults to <origin>/admin/callback when blank.
VITE_COGNITO_REDIRECT_URI=

# CloudFront origin serving published manifests, e.g. https://d123.cloudfront.net
VITE_CLOUDFRONT_ORIGIN=

# Canonical production URL — printable QR codes are generated ONLY from this.
VITE_CANONICAL_ORIGIN=
